#!/usr/bin/env bash
# Enforces Git Flow branch protection.
# Install: git config core.hooksPath .githooks

current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed 's|refs/heads/||')

# Hard block: never push directly to master
if [ "$current_branch" = "master" ]; then
    echo ""
    echo "⛔  Push direct sur 'master' interdit."
    echo "    Ouvre une Pull Request depuis 'develop' → 'master'."
    echo "    Voir CONTRIBUTING.md pour le Git Flow complet."
    echo ""
    exit 1
fi

# Soft warning: develop should receive PRs, not direct commits
if [ "$current_branch" = "develop" ]; then
    echo ""
    echo "⚠️   Tu pushes directement sur 'develop'."
    echo "    Préfère une branche feat/ et une PR, sauf pour merges ou setup."
    echo "    (push autorisé — appuie sur Ctrl+C dans les 5s pour annuler)"
    echo ""
    sleep 5
fi

exit 0
